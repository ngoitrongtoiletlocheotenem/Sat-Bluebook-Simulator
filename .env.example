# Default self-hosted database. PostgreSQL uses DATABASE_URL instead.
SQLITE_PATH=./data/sat.sqlite
# DATABASE_URL=postgresql://pathwise:CHANGE_ME@127.0.0.1:5432/pathwise
PORT=3001
HOST=127.0.0.1
# Development Vite origin; change to your public HTTPS URL in production.
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
SEED_SAMPLE_DATA=true
UPLOAD_DIR=./data/uploads
# Set only behind a known reverse proxy; 1 trusts exactly one proxy hop.
# TRUST_PROXY=1
# Optional initial administrator. Set a strong unique password, then remove it
# after npm run admin. No default credentials are built into the application.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# Only use with Desmos API production authorization and your own API key.
# VITE_DESMOS_API_KEY=
VITE_DESMOS_API_VERSION=1.12

# Optional trusted exact-form/version scoring model; default is estimated.
# SCORING_MODEL_FILE=./data/scoring-model.json
